# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
SWAGGER_ENABLED=true

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth (자체 발급 JWT — Supabase Auth 미사용, tb_user.password에 bcrypt 해시 저장)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=14d

# Identity Verification
# 응시 중 재인증을 요구할 최소/최대 간격(분). 실제 요청 간격은 이 범위 내에서 무작위로 산출됩니다.
IDENTITY_VERIFICATION_MIN_INTERVAL_MINUTES=5
IDENTITY_VERIFICATION_MAX_INTERVAL_MINUTES=15
# 연속 실패 허용 횟수. 이 값을 초과하면 DISQUALIFICATION, 그 전까지는 WARNING.
IDENTITY_VERIFICATION_MAX_FAILURES_BEFORE_DISQUALIFICATION=2
# true로 설정하면 mock provider가 모든 인증 시도를 강제로 실패 처리합니다 (정책 테스트용, production에서는 무시됨).
IDENTITY_VERIFICATION_MOCK_FORCE_FAIL=false
