# App
NODE_ENV=development
PORT=3000
# '*'면 전부 허용. 그 외엔 쉼표로 구분한 정확한 origin 목록만 허용(예: 프로덕션 프런트 도메인).
# http://localhost:<포트> 는 이 값과 무관하게 코드에서 항상 허용한다(로컬 프런트 개발용, src/main.ts 참고).
CORS_ORIGIN=https://ktest.cloud
SWAGGER_ENABLED=true
# 시험 시작(POST /exams/:id/sessions) 시 본인인증(matched:true 기록) 완료를 요구할지 여부.
# AI팀 본인인증 서비스가 아직 배포되지 않은 개발/테스트 기간에만 false로 내려 임시 우회한다.
# 기본값 true(강제) — 실제 서비스 배포 전에는 반드시 true로 되돌릴 것(또는 이 줄 자체를 삭제).
REQUIRE_IDENTITY_VERIFICATION=true
# 시험 시작 시 이어폰 미착용 확인(earphone_detected:false 기록) 완료를 요구할지 여부.
# REQUIRE_IDENTITY_VERIFICATION과 같은 이유(AI팀 서비스 미배포 기간)로 임시 우회용.
# 기본값 true(강제) — 실제 서비스 배포 전에는 반드시 true로 되돌릴 것(또는 이 줄 자체를 삭제).
REQUIRE_EARPHONE_CHECK=true
# 시선 캘리브레이션(calibrate) 통신 실패를 에러로 알릴지 여부. false면 실패해도 조용히
# "캘리브레이션 안 됨"으로 처리한다(analyze처럼). 기본값 true(강제) — 실제 서비스 배포 전에는
# 반드시 true로 되돌릴 것(또는 이 줄 자체를 삭제). analyze는 이 값과 무관하게 항상 조용히 처리한다
# (시험 진행 중 계속 호출되는 API라 응시 화면이 깨지면 안 되는 영구적인 설계 원칙).
REQUIRE_MONITORING_SERVICE=true
# 미완료 최종 리포트(/finalize) 재시도 스케줄러(5분 주기) 동작 여부. assessment 서비스가
# 로컬에 항상 떠 있지 않은 개발 환경에서는 false로 꺼서 매 5분 실패 로그가 쌓이는 걸 막을 수 있다.
# 기본값 true(운영 기준 항상 켜짐).
ENABLE_REPORT_RETRY_SCHEDULER=true

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth (자체 발급 JWT — Supabase Auth 미사용, tb_user.password에 bcrypt 해시 저장)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=14d

# 관리자 계정 생성(POST /auth/admin/sign-up) 시 요구하는 공유 비밀값 — 첫 관리자
# 부트스트랩용. 실제 운영자에게만 안전하게 공유할 것 (커밋 금지).
ADMIN_SIGNUP_SECRET=change-me-to-a-long-random-string

# Identity Verification
# 응시 중 재인증을 요구할 최소/최대 간격(분). 실제 요청 간격은 이 범위 내에서 무작위로 산출됩니다.
IDENTITY_VERIFICATION_MIN_INTERVAL_MINUTES=5
IDENTITY_VERIFICATION_MAX_INTERVAL_MINUTES=15
# 연속 실패 허용 횟수. 이 값을 초과하면 DISQUALIFICATION, 그 전까지는 WARNING.
IDENTITY_VERIFICATION_MAX_FAILURES_BEFORE_DISQUALIFICATION=2
# true로 설정하면 mock provider가 모든 인증 시도를 강제로 실패 처리합니다 (정책 테스트용, production에서는 무시됨).
IDENTITY_VERIFICATION_MOCK_FORCE_FAIL=false

# 신분증-얼굴 대조/이어폰 감지/부정행위 감지(웹캠 프레임 분석)를 맡는 서비스 베이스 URL —
# 세 기능 모두 같은 서비스라 하나로 공유한다.
# (POST {MONITORING_URL}/identity/verify, {MONITORING_URL}/earphone/detect, {MONITORING_URL}/monitoring/analyze 호출)
MONITORING_URL=http://localhost:8000

# 답안 채점(writing/speaking)을 맡는 assessment 서비스 베이스 URL (POST {ASSESSMENT_URL}/score 호출)
# 답안이 저장될 때마다(answer.saved 이벤트) 자동으로 호출됩니다.
ASSESSMENT_URL=http://localhost:8001
# assessment 서비스가 X-API-Key를 요구하도록 켜져 있으면 여기에 넣을 것. 비워두면 헤더를 아예 안 보냄(assessment 개발 모드와 매칭).
ASSESSMENT_API_KEY=

# 회원가입 이메일 인증(6자리 코드) 발송용 SMTP. 비워두면 발송이 조용히 실패만 하고
# (로그로만 남고 예외를 던지지 않음) 가입/재발송 자체는 그대로 성공합니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=K-TEST <no-reply@ktest.local>
