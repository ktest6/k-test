# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
SWAGGER_ENABLED=true

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth (자체 발급 JWT — Supabase Auth 미사용, tb_user.password에 bcrypt 해시 저장)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=14d

# 관리자 계정 생성(POST /auth/admin/sign-up) 시 요구하는 공유 비밀값 — 첫 관리자
# 부트스트랩용. 실제 운영자에게만 안전하게 공유할 것 (커밋 금지).
ADMIN_SIGNUP_SECRET=change-me-to-a-long-random-string

# Identity Verification
# 응시 중 재인증을 요구할 최소/최대 간격(분). 실제 요청 간격은 이 범위 내에서 무작위로 산출됩니다.
IDENTITY_VERIFICATION_MIN_INTERVAL_MINUTES=5
IDENTITY_VERIFICATION_MAX_INTERVAL_MINUTES=15
# 연속 실패 허용 횟수. 이 값을 초과하면 DISQUALIFICATION, 그 전까지는 WARNING.
IDENTITY_VERIFICATION_MAX_FAILURES_BEFORE_DISQUALIFICATION=2
# true로 설정하면 mock provider가 모든 인증 시도를 강제로 실패 처리합니다 (정책 테스트용, production에서는 무시됨).
IDENTITY_VERIFICATION_MOCK_FORCE_FAIL=false

# 신분증-얼굴 대조/이어폰 감지/부정행위 감지(웹캠 프레임 분석)를 맡는 FastAPI 서비스 베이스 URL —
# 세 기능 모두 같은 서비스라 하나로 공유한다.
# (POST {FASTAPI_URL}/identity/verify, {FASTAPI_URL}/earphone/detect, {FASTAPI_URL}/monitoring/analyze 호출)
FASTAPI_URL=http://localhost:8000

# 답안 채점(writing/speaking)을 맡는 assessment 서비스 베이스 URL (POST {ASSESSMENT_URL}/score 호출)
# 답안이 저장될 때마다(answer.saved 이벤트) 자동으로 호출됩니다.
ASSESSMENT_URL=http://localhost:8001
# assessment 서비스가 X-API-Key를 요구하도록 켜져 있으면 여기에 넣을 것. 비워두면 헤더를 아예 안 보냄(assessment 개발 모드와 매칭).
ASSESSMENT_API_KEY=
