# LoRA 받아쓰기 서버 (8100) — 우리가 학습한 Whisper LoRA v2 로 음성을 글자로 바꾼다.
#
# 이 서버는 **바깥에 열지 않는다.** 채점 서버(같은 VM 안)만 부른다.
# 그래서 --host 를 127.0.0.1 로 못 박았다 — 방화벽 설정을 실수해도 바깥에서
# 접속 자체가 안 된다(방화벽보다 이쪽이 확실하다).
#
# 놓는 자리:  /etc/systemd/system/ktest-stt.service   (setup.sh 가 복사해 준다)
# 켜기:       sudo systemctl restart ktest-stt
# 로그 보기:  journalctl -u ktest-stt -f
#
# 아래 경로는 setup.sh 의 VENV_STT · ASSESS_DIR · ENV_FILE 과 **글자까지 같아야 한다.**

[Unit]
Description=K-TEST LoRA STT server (port 8100, GPU)
# 네트워크가 준비된 뒤에 뜨게 한다(베이스 모델을 처음 받을 때 인터넷이 필요하다)
After=network-online.target
Wants=network-online.target
# 재시작을 몇 번 하든 systemd 가 포기하지 않게 한다.
# 시연 도중 잠깐 죽었을 때 "너무 자주 죽었다"며 손을 놓아 버리면 안 되기 때문이다.
StartLimitIntervalSec=0

[Service]
Type=simple
User=ktest
Group=ktest
WorkingDirectory=/opt/ktest/repo/assessment
# 열쇠와 설정(LORA_ADAPTER_DIR · HF_HOME 등)은 전부 이 파일에서 온다
EnvironmentFile=/opt/ktest/env/ktest.env
ExecStart=/opt/ktest/venv-stt/bin/python scripts/speech_lab/lora_stt_server.py --host 127.0.0.1 --port 8100
# 죽으면 5초 뒤 다시 띄운다
Restart=always
RestartSec=5
# 모델을 불러오는 데 시간이 걸려서(1~2분) 넉넉히 준다
TimeoutStartSec=600
# 로그를 journal 로 보낸다(위의 journalctl 로 본다)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
