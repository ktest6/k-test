# ============================================================================
# 시연 서버(GCP)의 열쇠·설정 파일 — 이 파일을 /opt/ktest/env/ktest.env 로 복사해 쓴다.
# setup.sh 가 처음 한 번만 복사해 주고, 그 다음부터는 손대지 않는다.
#
# **여기에 진짜 열쇠 값을 적어서 저장소에 올리지 마라.** 이 파일(env.template)은
# git 에 들어가는 파일이고, 값이 채워지는 것은 VM 안의 ktest.env 하나뿐이다.
#
# 적는 규칙 (systemd 가 읽는 형식이라 .env 와 조금 다르다)
#   · KEY=값  꼴로만 적는다. `export` 를 앞에 붙이지 않는다.
#   · 값에 따옴표를 씌우지 않는다. 씌우면 따옴표까지 값이 된다.
#   · 주석(#)은 줄 맨 앞에만 쓴다. 값 뒤에 붙이면 그것도 값으로 들어간다.
#
# 채운 뒤:
#   sudo systemctl restart ktest-stt ktest-api
# ============================================================================

# ── 반드시 채워야 하는 것 ────────────────────────────────────────────────────

# Gemini 열쇠. 이게 비면 체크리스트 판정·오류 자질이 전부 안 되고 채점이 껍데기가 된다.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── 채점에 쓰는 모델 이름 (비밀 아님 · 지금 쓰는 값 그대로 적어 뒀다) ────────

# 체크리스트 판정과 STT 전사 보정에 쓰는 기본 모델.
GEMINI_MODEL=gemini-3.1-flash-lite

# 오류 자질(조사·어미 활용·어휘 오용·높임법)만 따로 쓰는 모델.
# 위의 lite 모델은 "어제 반장님이 말했습니다" 같은 높임법 오류를 놓치는 것이
# 실측으로 확인돼서, 이것만 상위 모델로 갈라 두었다.
GEMINI_MODEL_ERRORS=gemini-3-flash-preview

# 위 모델이 "지금 붐벼서 못 받는다"(503)고 할 때 대신 부르는 모델.
# 2026-08-26 GCP 실측: 오류 판정 모델이 503 을 내며 한 건에 55~113초가 걸렸다(정상 4~7초).
# 503 일 때만 이 모델로 한 번 갈아타서 다시 부른다(429·키 오류에는 갈아타지 않는다).
# 위 모델과 같은 이름을 적으면 갈아탈 곳이 없다는 뜻이라 대체하지 않는다.
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# 안전 문서에서 문항을 만들 때만 쓰는 모델.
GEMINI_MODEL_GENERATION=gemini-3-flash-preview

# Gemini 로 받아쓸 때 쓰는 모델(아래 KTEST_STT_PROVIDER 가 gemini 일 때만 쓰인다).
GEMINI_MODEL_STT=gemini-3.1-flash-lite

# ── 말하기: 받아쓰기와 발음 ─────────────────────────────────────────────────

# 받아쓰기를 누가 하나. lora = 우리가 학습한 LoRA 서버(8100)가 한다.
# **lora 로 둔 이상 8100 서버가 떠 있어야 한다. 안 떠 있으면 말하기 채점이 전부 503 이다.**
# (쓰기 채점은 영향 없다. 급할 때는 gemini 로 바꾸면 8100 없이도 말하기가 돈다.)
KTEST_STT_PROVIDER=lora

# LoRA 받아쓰기 서버 주소. 같은 VM 안에서만 부르므로 127.0.0.1 이다.
# 바깥에서 8100 을 부를 일이 없어야 정상이다(방화벽에서도 막아 둔다).
LORA_STT_URL=http://127.0.0.1:8100

# LoRA 어댑터(학습해 둔 v2)를 푼 폴더. 받아쓰기 서버(8100)가 이 값을 읽는다.
# 이 폴더 바로 밑에 adapter_config.json 이 보여야 한다.
LORA_ADAPTER_DIR=/opt/ktest/adapters/v2

# 받아쓸 언어. 이 시험은 한국어만 본다. 비워 두면 korean 이다.
LORA_LANGUAGE=korean

# 발음(발화 전달력) 점수는 Azure 가 낸다. 이 둘이 비면 delivery 영역만 비고
# 나머지 채점은 그대로 된다(서버가 죽지 않는다).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── 선택 ────────────────────────────────────────────────────────────────────

# 채점 API 열쇠. **넣는 순간부터 서버가 잠긴다.**
#   비워 두면  -> 전부 열림(개발 모드)
#   값을 넣으면 -> 모든 POST 에 X-API-Key 헤더가 있어야 한다. 없으면 401.
# 넣었다면 백엔드의 ASSESSMENT_API_KEY 에 **같은 값**을 넣어야 한다.
# 주의: 영문·숫자로만 만든다(HTTP 헤더에 한글을 담을 수 없다).
# 시연 서버는 고정 IP 로 바깥에 열려 있으므로 여기에 값을 넣기를 권한다.
KTEST_API_KEY=

# (선택) 구글 SDK 가 보는 다른 이름의 열쇠. 보통 비워 둔다.
GOOGLE_API_KEY=

# (선택) 국립국어원 등급별 어휘 목록 파일 경로.
# 비워 두면 저장소 안의 임시 씨앗 목록을 쓴다.
KTEST_VOCAB_LEVELS=

# ── 서버 살림살이 ───────────────────────────────────────────────────────────

# 허깅페이스가 베이스 모델(openai/whisper-small, 약 1GB)을 받아 둘 자리.
# 이걸 안 정해 두면 서비스 계정의 홈 폴더로 받으려다 권한·용량에서 걸린다.
HF_HOME=/opt/ktest/hf_cache
