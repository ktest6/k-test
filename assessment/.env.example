# 이 파일을 복사해서 .env 로 이름을 바꾸고, 값을 채워 넣으세요.
#   copy .env.example .env
# .env 는 .gitignore 에 들어 있어 저장소에 올라가지 않습니다.

# Gemini API 키. https://aistudio.google.com/apikey 에서 발급받습니다.
GEMINI_API_KEY=

# 쓸 모델 이름. 비워 두면 gemini-3.5-flash 를 씁니다.
# 체크리스트 판정과 오류 자질 추출은 고난도 추론이 아니라서
# 비용과 응답 속도가 더 중요하다고 보고 flash 계열을 기본값으로 두었습니다.
GEMINI_MODEL=gemini-3.1-flash-lite

# (선택) 국립국어원 등급별 어휘 목록 파일 경로.
# 비워 두면 src/resources/vocab_levels_ko.tsv 의 임시 씨앗 목록을 씁니다.
KTEST_VOCAB_LEVELS=
