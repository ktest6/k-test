# 이 파일을 복사해서 .env 로 이름을 바꾸고, 값을 채워 넣으세요.
#   copy .env.example .env
# .env 는 .gitignore 에 들어 있어 저장소에 올라가지 않습니다.

# Gemini API 키. https://aistudio.google.com/apikey 에서 발급받습니다.
GEMINI_API_KEY=

# 쓸 모델 이름. 비워 두면 gemini-3.5-flash 를 씁니다.
# 체크리스트 판정과 오류 자질 추출은 고난도 추론이 아니라서
# 비용과 응답 속도가 더 중요하다고 보고 flash 계열을 기본값으로 두었습니다.
GEMINI_MODEL=gemini-3.1-flash-lite

# 오류 자질(조사·어미 활용·어휘 오용·높임법)만 따로 쓰는 모델.
# 비워 두면 gemini-3-flash-preview 를 씁니다.
#
# 왜 이것만 다른 모델을 쓰나:
# "어제 반장님이 말했습니다" 는 상급자를 안 높인 높임법 오류인데,
# 위의 lite 모델은 이것을 잡지 못하고 상위 모델은 잡는 것이 실측으로 확인됐습니다.
# 오류를 못 찾으면 그 답안은 '틀린 것이 없는 답안'이 되어 점수가 부풀려집니다.
# 체크리스트 판정과 STT 전사 보정은 위의 GEMINI_MODEL 을 그대로 씁니다.
#
# 이름 주의: 'gemini-3-flash' 가 아니라 'gemini-3-flash-preview' 입니다.
GEMINI_MODEL_ERRORS=gemini-3-flash-preview

# 안전 문서에서 문항을 만들 때만 쓰는 모델.
# 비워 두면 gemini-3-flash-preview 를 씁니다.
#
# 왜 생성만 따로 두나:
# 실제 KOSHA 안전문서로 통과를 확인한 모델이 이것입니다.
# lite 계열은 생성에서 검증해 본 적이 없어 기본값으로 쓰지 않습니다.
GEMINI_MODEL_GENERATION=gemini-3-flash-preview

# 말하기 음성을 글자로 받아쓸 때만 쓰는 모델.
# 비워 두면 gemini-3.1-flash-lite 를 씁니다.
#
# 왜 받아쓰기만 따로 두나:
# 원래는 Azure 음성 서비스로 할 일인데 계정이 없어서 Gemini 로 대신하고 있습니다.
# 나중에 Azure 로 바꿀 때 이 값만 안 쓰게 되고 나머지 설정은 그대로입니다.
# 실제 음성으로 받아쓰기가 되는 것을 확인한 모델입니다(11.8초 음성, 글자 일치율 95.8%).
GEMINI_MODEL_STT=gemini-3.1-flash-lite

# (선택) 채점 API 키. **넣는 순간부터 서버가 잠깁니다.**
#
#   비워 두면  -> 지금처럼 전부 열립니다 (개발 모드). 백엔드 연동 테스트에 편합니다.
#   값을 넣으면 -> 모든 POST 요청에 X-API-Key 헤더가 있어야 합니다. 없거나 틀리면 401.
#
# GET /health 와 /docs 는 어느 쪽에서도 열려 있습니다.
# 지금 인증이 켜져 있는지는 /health 의 auth_enabled 값으로 확인합니다.
#
# 주의: 키는 영문·숫자로만 만드세요. HTTP 헤더에는 한글을 담을 수 없습니다.
KTEST_API_KEY=

# (선택) 국립국어원 등급별 어휘 목록 파일 경로.
# 비워 두면 src/resources/vocab_levels_ko.tsv 의 임시 씨앗 목록을 씁니다.
KTEST_VOCAB_LEVELS=
